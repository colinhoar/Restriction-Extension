{
  "manifest_version": 3,
  "name": "Focus Guardian",
  "version": "2.2.0",
  "description": "Block Instagram and last.fm and create a distraction-free, Shorts-free YouTube experience, with a puzzle gauntlet, timed disabling, and a guarded extensions page.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://last.fm/*",
    "*://*.last.fm/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://last.fm/*",
        "*://*.last.fm/*"
      ],
      "js": [
        "content/site-blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "run_at": "document_end",
      "css": [
        "content/youtube.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
